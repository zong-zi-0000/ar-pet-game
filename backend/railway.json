{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixpacksDeps": [
            "nodejs_20"
          ]
        },
        "build": {
          "cmds": [
            "npm install"
          ]
        }
      },
      "start": {
        "cmd": "npm start"
      }
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthCheckPath": "/health"
  },
  "variables": {
    "NODE_ENV": "production",
    "PORT": "8080"
  }
}
